# Generated by generate_quran_db.py and published as a release asset, never tracked.
# No leading slash, so this matches at any depth: a root-level copy was removed once
# in d3b0975 and came back, because the rule used to cover only tools/.
quran.db

# --- ML / training artifacts (Linux + CUDA) ---
# Conda / virtual envs created inside the repo
/envs/
.venv/
# Hugging Face + dataset caches and local downloads
.cache/
data_cache/
# Checkpoints, adapters, training runs, logs
checkpoints/
outputs/
runs/
wandb/
*.ckpt
# Filtering manifests / intermediate data
*.parquet
*.jsonl
# Curated eval fixtures are source-of-truth, not generated data — keep them tracked.
!tools/tadabur/eval_fixtures/should_accept.jsonl
!tools/tadabur/eval_fixtures/should_reject.jsonl
# Human-adjudicated verdicts on the reject pile's repeat-carrying clips (#66).
!tools/tadabur/eval_fixtures/reject_reread_verdicts.jsonl
# Per-edge neighbour-ayah bleed labels for those same clips (#67) — the bleed detector's
# regression set. Carries each clip's decode, so a re-score needs no filtering run.
!tools/tadabur/eval_fixtures/reject_bleed_labels.jsonl
# Frozen, reciter-disjoint waqf eval partitions (#30) — versioned source-of-truth for F1/F2.
!tools/tadabur/waqf_event_fixtures/waqf_events.calibration.jsonl
!tools/tadabur/waqf_event_fixtures/waqf_events.test.jsonl
# Frozen P7.H conditional-reference integration cases (#35) — the product gate's source-of-truth.
!tools/tadabur/waqf_integration_fixtures/waqf_integration_cases.jsonl
# The tashkeel counterfactual item manifest (#10) — the recording sheet's machine-readable
# twin, read by the scorer. Source-of-truth for an experiment whose audio is recorded by hand,
# so it must stay tracked or the recordings become unscorable.
!tools/tadabur/tashkeel_counterfactual_fixtures/counterfactual_items.jsonl
# Generated integration-eval report — a pure derivative of the frozen cases above, regenerated by
# `python -m tadabur.waqf_integration_eval`; not source-of-truth, so it is not tracked.
tools/tadabur/waqf_integration_fixtures/waqf_integration_eval.json
# Tadabur reference-phoneme cache (regenerated deterministically)
tools/tadabur/cache/
# CoreML export outputs (macOS)
coreml_models/
coreml_models_chunked/
compiled_models/
*.mlpackage/
*.mlmodelc/
models.zip

# AFK dual-agent loop (ralph-loop.sh) state
.ralph/

# Claude Code local state (shared config in .claude/skills/ IS tracked)
.claude/settings.local.json
.claude/projects/
.claude/sessions/

# Local P3.5 audit run artifacts (manifest, worklist, exported audio)
tools/tadabur/audit_run/

# Local reject-mining run artifacts (manifests, staged clean-re-read WAVs, run logs).
# The committed reports in docs/ carry the numbers; these are the run's own output.
tools/tadabur/reject_run/
tools/tadabur/reject_run_*.log

# Local bleed-recut run artifacts (staged WAVs, timed decodes, recut records, recut audio).
# docs/tadabur-bleed-recut.md carries the numbers; this is the run's own output.
tools/tadabur/bleed_run/

# Local re-read corpus run artifacts (#70): the reject sink, the staged clean re-read
# WAVs, the timed decodes, the recuts and the bundle. docs/tadabur-corpus-run.md carries
# the numbers; the bundle itself is shipped to the Mac rather than committed.
tools/tadabur/corpus_run/

# Local scenario-staging run artifacts (the bundle Muraja consumes: scenario.jsonl, staged
# WAVs, excised control clips). docs/tadabur-excision-yield.md carries the numbers, and the
# bundle itself is shipped to the Mac rather than committed.
tools/tadabur/scenario_run/

# Local waqf-audit review state (per-reviewer, not source-of-truth)
tools/tadabur/waqf_event_fixtures/waqf_reviewed_clips.json
tools/tadabur/waqf_event_fixtures/waqf_flagged_clips.json
# Transient waqf-review backup snapshots (session artifacts, never source-of-truth)
*.bak

# Local agent scratch file
.copilot-scratch
